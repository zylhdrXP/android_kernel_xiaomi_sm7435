# Battery/Fuel Gauge
CONFIG_BQ_FG_UPDATE=y
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_HAVE_CHARGE_TEMP=y
CONFIG_MI_CHARGE_PROPERTY=y
# CONFIG_MI_WIRELESS is not set

# Device Tree Overlay
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Fingerprint
CONFIG_FINGERPRINT_FPC_FOD=m
CONFIG_FINGERPRINT_GOODIX_FOD_G3S=m
CONFIG_INPUT_FINGERPRINT=y

# HWID
CONFIG_MI_HARDWARE_ID=m

# Haptics
CONFIG_INPUT_QCOM_HV_HAPTICS=m

# Infrared and Remote Control
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# MTD
CONFIG_MTD=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_OOPS=m

# Net
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y

# Regulator Drivers
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=y
CONFIG_REGULATOR_QPNP_AMOLED=m
CONFIG_REGULATOR_WL2866D_N16=m

# SKU
CONFIG_BOOTCONFIG_HWC_IS_PRODUCT_SKU=y

# SPSS
# CONFIG_QCOM_SPSS is not set
# CONFIG_RPMSG_QCOM_GLINK_SPSS is not set

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# Touchscreen
CONFIG_TOUCHSCREEN_FOCALTECH_3683G=m
CONFIG_TOUCHSCREEN_GOODIX_BRL=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# USB Networking
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_AX8817X=m

# KSU
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_KSU=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
CONFIG_KPM=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KALLSYMS=y
CONFIG_TMPFS_POSIX_ACL=y

# SUSFS
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_SU=n
